        <item name="colorPrimaryDark">@color/primario_oscuro</item>
        <item name="colorPrimaryVariant">@color/primario_oscuro</item>
        <item name="colorAccent">@color/acento</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="android:windowBackground">@color/fondo</item>
