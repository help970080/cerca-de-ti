<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvOnbTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="@color/primario"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Cerca de Ti" />

        <TextView
            android:id="@+id/tvOnbTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="Texto explicativo del paso de onboarding..." />

        <EditText
            android:id="@+id/etOnbCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:inputType="text"
            android:visibility="gone"
            android:autofillHints="" />

        <CheckBox
            android:id="@+id/chkConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/chk_consent_texto"
            android:textColor="@color/texto_principal"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOnbSiguiente"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/acento"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Siguiente" />

    </LinearLayout>
</ScrollView>